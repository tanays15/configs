# Caps Lock is remapped by Karabiner to cmd + alt + ctrl.
# Adding shift on top completes all four modifiers, which skhd calls "hyper".
#   caps + key          -> cmd + alt + ctrl - key
#   caps + shift + key  -> hyper - key
# Keep the two layers distinct: "shift + hyper" and "ctrl + hyper" are NOT
# separate bindings, since hyper already contains shift and ctrl.

# -- focus (caps) --
cmd + alt + ctrl - h : yabai -m window --focus west
cmd + alt + ctrl - j : yabai -m window --focus south
cmd + alt + ctrl - k : yabai -m window --focus north
cmd + alt + ctrl - l : yabai -m window --focus east

# -- swap (caps + shift) --
hyper - h : yabai -m window --swap west
hyper - j : yabai -m window --swap south
hyper - k : yabai -m window --swap north
hyper - l : yabai -m window --swap east

# -- warp: needs its own keys, no modifiers left --
cmd + alt + ctrl - y : yabai -m window --warp west
cmd + alt + ctrl - o : yabai -m window --warp east

# -- zoom --
cmd + alt + ctrl - f : yabai -m window --toggle zoom-fullscreen

# -- close the focused window --
cmd + alt + ctrl - q : yabai -m window --close

# -- spaces: focus (caps) vs send window (caps + shift) --
cmd + alt + ctrl - 1 : yabai -m space --focus 1
cmd + alt + ctrl - 2 : yabai -m space --focus 2
cmd + alt + ctrl - 3 : yabai -m space --focus 3

hyper - 1 : yabai -m window --space 1
hyper - 2 : yabai -m window --space 2
hyper - 3 : yabai -m window --space 3

# -- reload --
hyper - r : yabai --restart-service

# -- applications --
cmd + alt + ctrl - b      : /Applications/Firefox.app/Contents/MacOS/firefox --new-window about:blank
cmd + alt + ctrl - return : open -a Ghostty && skhd -k "cmd - n"
cmd + alt + ctrl - d      : open Discord
