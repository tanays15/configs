#!/usr/bin/env bash

yabai -m config layout bsp

yabai -m config top_padding 15
yabai -m config bottom_padding 15
yabai -m config left_padding 15
yabai -m config right_padding 15
yabai -m config window_gap 15

yabai -m config window_placement second_child

yabai -m config mouse_modifier fn

yabai -m config focus_follows_mouse autoraise
yabai -m config mouse_follows_focus on

# Closing a window often leaves macOS with nothing focused. When a window is
# destroyed, check whether anything still has focus; if not, focus the window
# under the mouse, falling back to the first window on the space. Registered as
# a signal (not an skhd bind) so it fires however the window was closed.
yabai -m signal --add event=window_destroyed action='yabai -m query --windows --window >/dev/null 2>&1 || yabai -m window --focus mouse >/dev/null 2>&1 || yabai -m window --focus "$(yabai -m query --windows --space | jq -r ".[0].id")" >/dev/null 2>&1'


# Firefox windows should always live in one stack per space. yabai keeps stacks
# in memory only, so they are gone after a restart: rebuild them here (in the
# background, since windows are still being registered while yabairc runs) and
# fold any newly created Firefox window into the existing stack.
yabai -m signal --add event=window_created app='^Firefox$' \
  action='"$HOME/.local/bin/yabai-stack-app" "^Firefox$"'

(sleep 2; "$HOME/.local/bin/yabai-stack-app" "^Firefox$") &
