#!/usr/bin/env bash
# Stack every window of an app into a single stack, one stack per space.
#
# yabai keeps stacks in memory only: they are runtime state, not part of a
# space's saved layout, so a restart drops every window back into the bsp
# tree. This script rebuilds them and is called from yabairc on startup and
# from a window_created signal whenever a new window shows up.
#
# Usage: yabai-stack-app '^Firefox$'   (argument is a regex matched on .app)
set -uo pipefail

app="${1:?usage: yabai-stack-app <app regex>}"

# Only windows yabai can actually stack: not floating, not minimized, not in
# native fullscreen. Group by space, since stacking is per display/space.
yabai -m query --windows | jq -r --arg app "$app" '
    [ .[]
      | select(.app | test($app))
      | select(."is-floating" == false)
      | select(."is-minimized" == false)
      | select(."is-native-fullscreen" == false)
    ]
    | group_by(.space)[]
    | map(.id | tostring)
    | select(length > 1)
    | join(" ")
  ' |
while read -r first rest; do
  for id in $rest; do
    # Stacks the given window onto the selected one; already-stacked windows
    # are a no-op, so this is safe to run repeatedly.
    yabai -m window "$first" --stack "$id" >/dev/null 2>&1
  done
done
